<Window x:Class="Novikov_AutoServicesRul.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автосервис Руль"
        Height="450" Width="800"
        MinHeight="450" MinWidth="800"
        Icon="/Resources/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="gridRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="gridHeader" Grid.Row="0" Background="#FF76E383">
            <Image x:Name="imageLogo" Width="45" Height="45" HorizontalAlignment="Left" Margin="5" Source="/Resources/logo.png"/>
            <Button x:Name="buttonGoBack" HorizontalAlignment="Right" Content="Назад" Click="buttonGoBack_Click" TabIndex="10"/>
        </Grid>
        <Frame x:Name="frameContent" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="frameContent_ContentRendered"/>
    </Grid>
</Window>
