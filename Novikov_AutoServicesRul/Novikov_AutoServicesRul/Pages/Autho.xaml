<Page x:Class="Novikov_AutoServicesRul.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Novikov_AutoServicesRul.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="labelLogin" Text="Логин:"/>
            <TextBox x:Name="textBoxLogin" TabIndex="0"/>
            <TextBlock x:Name="labelPassword" Text="Пароль:"/>
            <PasswordBox x:Name="passwordBoxPassword" TabIndex="1"/>
            <TextBlock x:Name="labelCaptcha" Text="Капча:" Visibility="Hidden"/>
            <TextBox x:Name="textBoxCaptcha" Visibility="Hidden"/>
            <TextBlock x:Name="labelTimer" HorizontalAlignment="Center" Visibility="Hidden"/>
            <StackPanel x:Name="panelActions" Orientation="Horizontal" Height="80" HorizontalAlignment="Center">
                <Button x:Name="buttonGuestLogin" Margin="5,15,5,5" Content="Войти как гость" Click="buttonGuestLogin_Click" TabIndex="3"/>
                <Button x:Name="buttonLogin" Margin="5,15,5,5" Content="Войти" Click="buttonLogin_Click" IsDefault="True" TabIndex="2"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
