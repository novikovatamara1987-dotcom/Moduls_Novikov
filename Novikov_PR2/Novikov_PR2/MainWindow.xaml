<Window x:Class="Novikov_PR2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новиков Никита - Вариант 2" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="183*"/>
            <ColumnDefinition Width="617*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="415*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Background="LightGray" Grid.ColumnSpan="2">
            <Label Content="Вариант № 2" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="472,13,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Name="btnTask1" Content="Задача 1" Click="btnTask1_Click" Width="80" Height="30" Margin="5"/>
                <Button Name="btnTask2" Content="Задача 2" Click="btnTask2_Click" Width="80" Height="30" Margin="5"/>
                <Button Name="btnTask3" Content="Задача 3" Click="btnTask3_Click" Width="80" Height="30" Margin="5"/>
                <Button Name="btnTask4" Content="Задача 4" Click="btnTask4_Click" Width="80" Height="30" Margin="5"/>
                <Button x:Name="btnTask5" Content="Задача 5" Click="btnTask5_Click" Width="80" Height="30"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2" Navigated="FrmMain_Navigated" Grid.RowSpan="2"/>
    </Grid>
</Window>