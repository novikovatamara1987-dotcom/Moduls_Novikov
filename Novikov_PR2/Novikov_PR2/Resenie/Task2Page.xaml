<Page x:Class="Novikov_PR2.Pages.Task2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 2">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Задача 2: Слова в обратном порядке" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Введите строку (слова через пробел):" Margin="0,5"/>
            <TextBox x:Name="txtInputString" Height="60" TextWrapping="Wrap" Padding="5"/>

            <Button x:Name="btnProcess" Content="Преобразовать" Click="btnProcess_Click" Width="150" HorizontalAlignment="Left" Margin="0,15" Padding="5"/>

            <TextBlock Text="Результат:" Margin="0,5"/>
            <TextBox x:Name="txtResult" IsReadOnly="True" Height="60" TextWrapping="Wrap" Padding="5" Background="#F4F4F4"/>
        </StackPanel>
    </Grid>
</Page>