<Page x:Class="Novikov_PR2.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 1">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Задача 1: Вычислить 2 * n! для n &lt;= 100 (n - натуральное)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Введите число n (от 1 до 100):" Margin="0,5"/>
            <TextBox x:Name="txtInputN" Width="200" HorizontalAlignment="Left" Padding="5"/>

            <Button x:Name="btnCalculate" Content="Рассчитать" Click="btnCalculate_Click" Width="150" HorizontalAlignment="Left" Margin="0,15" Padding="5"/>

            <TextBlock Text="Результат:" Margin="0,5"/>
            <TextBox x:Name="txtResult" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5" Background="#F4F4F4"/>
        </StackPanel>
    </Grid>
</Page>