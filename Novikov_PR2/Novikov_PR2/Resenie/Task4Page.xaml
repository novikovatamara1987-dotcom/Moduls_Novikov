<Page x:Class="Novikov_PR2.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 4">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Задача 4: Разделение массива относительно числа b" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Введите число b:" Margin="0,5"/>
            <TextBox x:Name="txtInputB" Width="150" HorizontalAlignment="Left" Padding="5"/>

            <TextBlock Text="Введите элементы массива через пробел:" Margin="0,10,0,5"/>
            <TextBox x:Name="txtInputArray" Padding="5"/>

            <Button x:Name="btnRearrange" Content="Переставить" Click="btnRearrange_Click" Width="150" HorizontalAlignment="Left" Margin="0,15" Padding="5"/>

            <TextBlock Text="Результат перестановки:" Margin="0,5"/>
            <TextBox x:Name="txtResult" IsReadOnly="True" Height="60" TextWrapping="Wrap" Padding="5" Background="#F4F4F4"/>
        </StackPanel>
    </Grid>
</Page>