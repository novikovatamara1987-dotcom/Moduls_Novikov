<Page x:Class="Novikov_PR2.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Задача 5: Генерация и сортировка двумерного массива" FontSize="16" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Строк (N):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtRowsN" Width="50" Margin="5,0,15,0" Padding="3" Text="3"/>

            <TextBlock Text="Столбцов (M):" VerticalAlignment="Center"/>
            <TextBox x:Name="txtColsM" Width="50" Margin="5,0,15,0" Padding="3" Text="4"/>

            <Button x:Name="btnGenerate" Content="Сгенерировать и отсортировать" Click="btnGenerate_Click" Padding="10,5"/>

            <TextBlock x:Name="txtMinMax" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2980B9"/>
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Исходный массив">
                <DataGrid x:Name="gridOriginal" IsReadOnly="True" AutoGenerateColumns="True"/>
            </TabItem>
            <TabItem Header="По возрастанию">
                <DataGrid x:Name="gridAscending" IsReadOnly="True" AutoGenerateColumns="True"/>
            </TabItem>
            <TabItem Header="По убыванию">
                <DataGrid x:Name="gridDescending" IsReadOnly="True" AutoGenerateColumns="True"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>